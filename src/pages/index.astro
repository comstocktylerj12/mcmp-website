---
import "../styles/global.scss";
import fullLogo from "../../public/assets/mcmp-logo.svg";
import gearLogo from "../../public/assets/mcmp-gear.svg";

const phone = "607-368-5333";
const email = "info@missioncriticalmp.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mission Critical Material Processing | On-Site Material Processing</title>
    <meta name="description" content="Mission Critical Material Processing provides on-site material processing for large-scale projects in Pennsylvania and surrounding areas." />
    <link rel="canonical" href="https://missioncriticalmp.com/" />
    <link rel="icon" type="image/svg+xml" href="/assets/mcmp-gear.svg" />
    <meta name="theme-color" content="#f5f6f7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Mission Critical Material Processing" />
    <meta property="og:description" content="On-site material processing for large-scale projects." />
    <meta property="og:url" content="https://missioncriticalmp.com/" />
    <meta property="og:image" content="https://missioncriticalmp.com/assets/mcmp-logo.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Mission Critical Material Processing",
      url: "https://missioncriticalmp.com/",
      email,
      telephone: "+1-607-368-5333",
      areaServed: "Pennsylvania and surrounding areas",
      description: "On-site material processing for large-scale projects."
    })} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-mark" href="/" aria-label="Mission Critical Material Processing home">
          <img src={gearLogo.src} alt="" />
        </a>
        <a class="header-contact" href={"mailto:" + email}>Contact MCMP <span>↗</span></a>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-grid"></div>
          <div class="hero-content">
            <p class="eyebrow"><span></span> Pennsylvania &amp; surrounding areas</p>
            <img class="full-logo" src={fullLogo.src} alt="Mission Critical Material Processing" />
            <h1 id="hero-title">On-site material processing for large-scale projects.</h1>
            <p class="hero-copy">
              Built on 10 years of industry experience, MCMP helps contractors turn onsite
              material into usable product while keeping production moving and schedules on track.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href={"tel:" + phone.replaceAll("-", "")}>Call {phone}</a>
              <a class="button button-secondary" href={"mailto:" + email}>Email us</a>
            </div>
          </div>
          <div class="hero-gear" aria-hidden="true">
            <img src={gearLogo.src} alt="" />
          </div>
        </section>

        <section class="status-panel" aria-labelledby="status-title">
          <div>
            <p class="section-kicker">01 / Current status</p>
            <h2 id="status-title">The full site is under construction.</h2>
          </div>
          <p>
            We’re building out the complete MCMP site now. In the meantime, we’re available
            directly for pricing, project questions, and employment inquiries.
          </p>
        </section>

        <section class="capabilities" aria-labelledby="capabilities-title">
          <div class="section-heading">
            <p class="section-kicker">02 / What we do</p>
            <h2 id="capabilities-title">Process material where the project needs it.</h2>
          </div>
          <div class="capability-list">
            <article>
              <span>01</span>
              <h3>Mobile crushing</h3>
              <p>On-site crushing and material processing for large-scale site work.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Material reuse</h3>
              <p>Turn suitable onsite material into usable product and reduce unnecessary movement.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Production support</h3>
              <p>Keep material moving so downstream site work can keep moving too.</p>
            </article>
          </div>
        </section>

        <section class="contact-band" aria-labelledby="contact-title">
          <div>
            <p class="section-kicker">03 / Start a conversation</p>
            <h2 id="contact-title">Have a project coming up?</h2>
          </div>
          <div class="contact-details">
            <a href={"tel:" + phone.replaceAll("-", "")}>{phone}</a>
            <a href={"mailto:" + email}>{email}</a>
          </div>
        </section>

        <section class="employment" aria-labelledby="employment-title">
          <div class="employment-copy">
            <p class="section-kicker">04 / Employment</p>
            <h2 id="employment-title">Looking for work?</h2>
            <p>For employment, please click the link for the application and send to the email below.</p>
            <p lang="es">Para empleo, haga clic en el enlace para la solicitud y envíelo al siguiente correo electrónico.</p>
            <a class="text-link" href="/employment-application.html">Open employment application <span>↗</span></a>
          </div>
          <div class="employment-note">
            <span>Applications</span>
            <a href={"mailto:" + email}>{email}</a>
          </div>
        </section>
      </main>

      <footer>
        <img src={gearLogo.src} alt="" />
        <span>Mission Critical Material Processing</span>
        <span>© {new Date().getFullYear()} MCMP</span>
      </footer>
    </div>
  </body>
</html>
