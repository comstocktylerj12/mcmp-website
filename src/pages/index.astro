---
import "../styles/global.scss";

const fullLogo = "/assets/mcmp-signature-logo.svg";
const gearLogo = "/assets/mcmp-gear.svg";

const phone = "607-368-5333";
const email = "info@missioncriticalmp.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mission Critical Material Processing | On-Site Material Processing</title>
    <meta
      name="description"
      content="Mission Critical Material Processing provides on-site material processing for large-scale projects in Pennsylvania and surrounding areas."
    />
    <link rel="canonical" href="https://missioncriticalmp.com/" />
    <link rel="icon" type="image/svg+xml" href={gearLogo} />
    <meta name="theme-color" content="#f6f7f8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Mission Critical Material Processing" />
    <meta property="og:description" content="On-site material processing for large-scale projects." />
    <meta property="og:url" content="https://missioncriticalmp.com/" />
    <meta property="og:image" content="https://missioncriticalmp.com/assets/mcmp-logo.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Mission Critical Material Processing",
      url: "https://missioncriticalmp.com/",
      email,
      telephone: "+1-607-368-5333",
      areaServed: "Pennsylvania and surrounding areas",
      description: "On-site material processing for large-scale projects."
    })} />
  </head>

  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-mark" href="/" aria-label="Mission Critical Material Processing home">
          <img class="header-logo" src={fullLogo} alt="Mission Critical Material Processing" />
        </a>

        <div class="header-meta">
          <span>PA &amp; Surrounding Areas</span>
          <a href={"tel:" + phone.replaceAll("-", "")}>{phone}</a>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-pattern" aria-hidden="true"></div>
          <div class="hero-gear" aria-hidden="true">
            <img src={gearLogo} alt="" />
          </div>

          <div class="hero-content">
            <div class="construction-badge"><span></span> Website currently under construction <span></span></div>
            <img class="full-logo" src={fullLogo} alt="Mission Critical Material Processing" />

            <p class="eyebrow">
              <span></span>
              Pennsylvania &amp; surrounding areas
              <span></span>
            </p>

            <h1 id="hero-title">On-site material processing for large-scale projects.</h1>

            <p class="hero-copy">
              Built on 10 years of industry experience, MCMP helps contractors turn onsite
              material into usable product while keeping production moving and schedules on track.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href={"tel:" + phone.replaceAll("-", "")}>Call {phone}</a>
              <a class="button button-secondary" href={"mailto:" + email}>Email {email}</a>
            </div>
          </div>
        </section>

        <section class="quick-info" aria-label="Mission Critical Material Processing overview">
          <article>
            <span class="info-number">01</span>
            <div>
              <h2>What we do</h2>
              <p>Mobile crushing, material reuse, and on-site production support.</p>
            </div>
          </article>

          <article>
            <span class="info-number">02</span>
            <div>
              <h2>Why it matters</h2>
              <p>Process suitable onsite material where it is needed and reduce unnecessary movement.</p>
            </div>
          </article>

          <article>
            <span class="info-number">03</span>
            <div>
              <h2>Currently building</h2>
              <p>The full MCMP website is under construction. We are available directly now.</p>
            </div>
          </article>
        </section>

        <section class="bottom-row">
          <div class="contact-block">
            <div class="bottom-copy">
              <p class="section-kicker">Projects &amp; pricing</p>
              <h2>Have a project coming up?</h2>
            </div>
            <div class="contact-links">
              <a href={"tel:" + phone.replaceAll("-", "")}>{phone}</a>
              <a href={"mailto:" + email}>{email}</a>
            </div>
          </div>

          <div class="employment-block">
            <div class="bottom-copy">
              <p class="section-kicker">Employment</p>
              <h2>Looking for work?</h2>
            </div>
            <div class="employment-links">
              <a class="text-link" href="/employment-application.html">Employment application <span>↗</span></a>
              <a href={"mailto:" + email}>{email}</a>
              <p lang="es">Solicitud disponible en inglés y español.</p>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <span>Mission Critical Material Processing</span>
        <span>© {new Date().getFullYear()} MCMP</span>
      </footer>
    </div>
  </body>
</html>
